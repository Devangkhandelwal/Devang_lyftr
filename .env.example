# Copy this file to .env and fill in real values.
# .env is gitignored: never commit real API keys.

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------

# Comma separated API keys, at least two so failover can be demonstrated.
# The order defines the key ids: the first is key_1, the second key_2, ...
# Only those ids are ever logged or returned; the key values never leave the
# server.
LLM_API_KEYS=your-first-api-key,your-second-api-key

# Any LiteLLM model id, for example:
#   gemini/gemini-3.1-flash-lite (Google AI Studio keys)
#   groq/llama-3.3-70b-versatile (Groq keys)
#
# Note: gemini-2.0-flash (named in the original brief) has been retired by
# Google and now returns 404. gemini-3.8-flash is frequently overloaded with
# 503s. gemini-3.1-flash-lite and gemini-3.5-flash were both verified working.
LLM_MODEL=gemini/gemini-3.1-flash-lite

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# SQLite only. Four slashes means an absolute path, which is what the
# docker-compose named volume mounted at /data expects.
# For a local run without Docker use: sqlite:///./data/app.db
DATABASE_URL=sqlite:////data/app.db

# LLM response cache: "local" keeps it in memory, "disk" persists it next to
# the database so it also survives a restart.
CACHE_TYPE=local

# ---------------------------------------------------------------------------
# API behaviour
# ---------------------------------------------------------------------------

# Comma separated list of browser origins allowed to call the API.
# Must match exactly, including the scheme, host and port.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# When true, the X-Simulate-Failure header is honoured. Set it to false to
# ignore that header completely.
ENABLE_FAILURE_SIMULATION=true

# Used whenever a session does not supply its own system prompt.
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.

# Port the backend listens on inside its container.
PORT=8000

# ---------------------------------------------------------------------------
# Frontend (build time)
# ---------------------------------------------------------------------------

# Vite inlines this into the bundle when the image is built, so changing it
# requires a rebuild, not just a restart.
VITE_API_URL=http://localhost:8000
